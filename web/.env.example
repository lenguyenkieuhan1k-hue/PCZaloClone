# ZaloMask web — copy file này thành .env.local rồi điền giá trị thật.
# Các biến có prefix NEXT_PUBLIC_ sẽ được Next.js gắn vào client bundle (an toàn để lộ).
# Các biến còn lại chỉ chạy server-side, KHÔNG bao giờ expose ra trình duyệt.

# --- Public ---
NEXT_PUBLIC_SITE_URL=https://zalomask.com
NEXT_PUBLIC_RELEASE_URL=https://github.com/YOUR_OWNER/YOUR_REPO/releases/latest
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Supabase admin ---
# Lấy ở Project Settings → API → service_role. Chỉ dùng phía server.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Ed25519 license token ---
# Sinh keypair: xem hướng dẫn trong web/README.md mục 3.
# Public key cũng nhúng vào app/config.json (licensePublicKeyPem) để Electron verify token.
LICENSE_TOKEN_PRIVATE_KEY=YOUR_ED25519_PRIVATE_KEY_PEM
LICENSE_TOKEN_PUBLIC_KEY=YOUR_ED25519_PUBLIC_KEY_PEM

# --- SePay (https://sepay.vn) ---
# Webhook gửi POST kèm Authorization: Apikey <SEPAY_WEBHOOK_SECRET>
SEPAY_WEBHOOK_SECRET=YOUR_SEPAY_WEBHOOK_SECRET
SEPAY_BANK_ACCOUNT_NUMBER=YOUR_BANK_NUMBER
SEPAY_BANK_NAME=YOUR_BANK_BIN_OR_NAME
SEPAY_ACCOUNT_HOLDER=Your Full Name

# --- Resend (https://resend.com) ---
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=ZaloMask <noreply@zalomask.com>

# --- Admin emails ---
# Cách nhau dấu phẩy. Admin được vào /admin và đọc audit_log.
ADMIN_EMAILS=seringuyen0506@gmail.com

# --- Dev seed (test license flow local) ---
# Chỉ accept khi NODE_ENV !== 'production'. Để trống ở môi trường prod.
DEV_SEED_SECRET=

# --- Chrome extension import ---
# Extension AutoZalo Bridge gửi session về /api/extension-import với header:
#   Authorization: Apikey <EXTENSION_IMPORT_SECRET>
EXTENSION_IMPORT_SECRET=
