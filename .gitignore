# --- Node ---
node_modules/
*.log
*.tsbuildinfo

# --- Electron build output ---
app/dist/
app/out/
app/dist-pcfix/

# --- Next.js ---
web/.next/
web/out/
web/next-env.d.ts
web/supabase/.temp/
web/client_secret_*.json

# --- Runtime files (per machine) ---
license-state.json
app-runtime.log
config.local.json

# --- Local secrets / environment ---
**/.env.local
**/.env.*.local
client_secret_*.json

# --- Local profile/session data ---
profiles/

# --- User exports / backups ---
ZaloMask_*.json
ZaloMask_zalo_web_*.json
ZaloMask_*.zmb
ZaloMask_*.zlp

# --- Profile data (chứa cookies + session — không bao giờ commit) ---
profiles/*/
!profiles/.gitkeep

# --- Backup exports — chứa session, không commit ---
ZaloMask_*.json
ZaloMask_*.zip
ZaloMask_*.zmask
*.session-export.json

# --- Env ---
.env
.env.local
.env.*.local
web/.env
web/.env.local
web/.env.*.local

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Misc ---
Claude Setup.exe
ZaXSetup-*.exe
*.pfx
*.p12

# --- Local temp / inspection ---
tmp-*/

# Bundled Zalo runtime — populate locally before build, never commit binary
app/zalo-runtime/*
!app/zalo-runtime/.gitkeep
!app/zalo-runtime/README.md

# Leftovers from one-off debugging / asar patcher runs
app/zalo-runtime/.asar-extract/
app/zalo-runtime/.asar-patch-done.txt
app/zalo-runtime/app-repacked.asar
app/bridge-traffic.log
app/proxy-bridge-*.log
**/ProgramData/ZaloMask/proxy/

# --- .NET native shell (parallel) ---
native/**/bin/
native/**/obj/
