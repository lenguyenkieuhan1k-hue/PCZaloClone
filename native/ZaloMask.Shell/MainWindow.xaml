<Window x:Class="ZaloMask.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZaloMask Shell — Preview (.NET)"
        Height="560" Width="720"
        MinHeight="420" MinWidth="560">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock FontSize="16" FontWeight="SemiBold"
                 Text="ZaloMask Shell (bản native, thử nghiệm)"
                 Margin="0,0,0,4"/>
      <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="12"
                 Text="Song song với bản Electron. Chọn đúng thư mục profiles để thấy cùng dữ liệu với ZaloMask PC."/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <DockPanel Margin="0,0,0,6">
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Width="120" Text="profiles:"/>
        <TextBox x:Name="ProfilesPathBox" VerticalContentAlignment="Center" IsReadOnly="True"/>
      </DockPanel>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnPickRoot" Content="Chọn gốc dữ liệu…" Padding="12,6" Click="BtnPickRoot_OnClick"/>
        <Button x:Name="BtnRefresh" Content="Làm mới" Margin="10,0,0,0" Padding="12,6" Click="BtnRefresh_OnClick"/>
      </StackPanel>
    </StackPanel>

    <GroupBox Header="Danh sách profile" Padding="10">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="#666" FontSize="12"
                   Text="Đọc thư mục con của profiles/ + meta.json (displayName)."/>
        <ListView x:Name="ProfileList" FontSize="13">
          <ListView.View>
            <GridView>
              <GridViewColumn Width="160" Header="Thư mục" DisplayMemberBinding="{Binding FolderName}"/>
              <GridViewColumn Width="220" Header="Tên hiển thị" DisplayMemberBinding="{Binding DisplayName}"/>
              <GridViewColumn Width="120" Header="launchMode" DisplayMemberBinding="{Binding LaunchMode}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </GroupBox>
  </DockPanel>
</Window>
